# Google Maps — enable "Places API (New)". Empty = demo data.
GOOGLE_MAPS_API_KEY=

# Reddit — create a "script"/"web" app at https://www.reddit.com/prefs/apps. Empty = demo data.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive user agent, e.g. web:leadscout:v0.1 (by /u/yourname)
REDDIT_USER_AGENT=

# OpenStreetMap needs no key. Optional: identify your app to Nominatim/Overpass.
OSM_USER_AGENT=
